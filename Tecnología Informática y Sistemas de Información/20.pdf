         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-repair">Business team with laptops look at digital presentation with charts. Digital presentation, office online meeting, visual data representation concept. Bright vibrant violet vector isolated illustration</rdf:li>
            </rdf:Alt>
